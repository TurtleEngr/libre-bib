<?php

# ========================================
# export-lo-2-txt.inc - class ExportLo2Txt, the work done by export-lo-2-txt.php.
#
# The wrapper (export-lo-2-txt.php) holds the usage POD and the main section;
# everything else is a method here, so phpunit can drive it.
#
# See style.org for the naming convention.
# ========================================

require_once __DIR__ . "/util.php";

class ExportLo2Txt {

    # Config, injected by the constructor.
    public $mConf;
    public $mDb;
    public $mUtil;
    public $mDbTblLo;
    public $mDebug;
    public $mDirTmp;
    public $mLoFile;

    # Options, from fGetOps().
    public $mOpt;

    # Working state.
    public $mFileH;
    public $mFileOut;

    # -----------------------------
    public function __construct($pConf, $pOpt = array()) {
        $this->mConf = $pConf;
        $this->mDbTblLo = isset($pConf["cgDbTblLo"]) ? $pConf["cgDbTblLo"] : "";
        $this->mDebug = isset($pConf["cgDebug"]) ? $pConf["cgDebug"] : "";
        $this->mDirTmp = isset($pConf["cgDirTmp"]) ? $pConf["cgDirTmp"] : "";
        $this->mLoFile = isset($pConf["cgLoFile"]) ? $pConf["cgLoFile"] : "";
        $this->mOpt = $pOpt;
        $this->mUtil = new Util($pConf);
    } # __construct

    # -----------------------------
    public static function fUsage($pScript) {
        # The POD is in the wrapper, not here.

        system("pod2text $pScript");
        exit(1);    # ---------->
    } # fUsage

    # -----------------------------
    public static function fGetOps($pArgv, $pArgc) {
        # Parse the command line only. Nothing here needs conf or a DB,
        # so -h and -T still work when neither is set up.

        $tOpt = getopt("chT:");

        return array(
            "help"=>isset($tOpt['h']) or $pArgc < 2,
            "change"=>isset($tOpt['c']),
            "test"=>isset($tOpt['T']) ? $tOpt['T'] : ""
        );    # ---------->
    } # fGetOps

    # -----------------------------
    public function fRun() {
        # The write section, as run by the wrapper.

        $this->fExportTable();
        return;    # ---------->
    } # fRun

    # -----------------------------
    public function fCleanUp() {
        echo "\n";
    } # fCleanUp

    # -----------------------------
    public function fValidate() {
        $this->mDb = Db::uFromConf($this->mConf);

        $this->mFileOut = "$this->mDirTmp" . '/' . "$this->mLoFile";
        if ("$this->mFileOut" == "")
            throw new Exception("\nError: Missing cgDirTmp/cgLoFile def. [export-lo-2-txt.php:" . __LINE__ . "]");

        if (($this->mFileH = fopen($this->mFileOut, "w")) == FALSE)
            throw new Exception("Cannot open file: $this->mFileOut. [export-lo-2-txt.php:" . __LINE__ . "]");

        if ( ! $this->mDb->uTableExists($this->mDbTblLo))
            throw new Exception("\nError: Missing table $this->mDbTblLo [export-lo-2-txt.php:" . __LINE__ . "]");
    } # fValidate

    # -----------------------------
    public function fExportTable() {
        fprintf($this->mFileH, "# Generated by export-lo-2-txt.php\n");
        fprintf($this->mFileH, "# " . Util::uDate("iso") . "\n\n");

        $tColList = array("Identifier", "Type", "RepType", "Booktitle",
            "Title", "Author", "Custom2", "Year", "Custom4", "Publisher",
            "Note", "ISBN", "Custom3", "URL", "Custom1", "Annote",
            "Address", "Chapter", "Edition", "Editor", "Howpublish",
            "Institutn", "Journal", "Month", "Number", "Organizat",
            "Pages", "School", "Series", "Volume", "Custom5");

        # Get all columns
        $tRecH = $this->mDb->uPrepare("select * from $this->mDbTblLo", __FILE__, __METHOD__, __LINE__);
        $tRecH->execute();

        # Get each record and output the biblio.txt block
        $tCount = 0;
        while ($tRec = $tRecH->fetch(PDO::FETCH_ASSOC)) {
            echo ".";
            ++$tCount;
            fprintf($this->mFileH, "\n");

            # Process in tColList order
            foreach (array_values($tColList) as $tCol) {
                $tVal = $tRec["$tCol"];
                if ("$tVal" == "")
                    continue;
                if ($tCol == "Type")
                    $tVal = Map::uType2Txt($tVal);
                fprintf($this->mFileH, "%s: %s\n", Map::uLo2TxtMap($tCol), $tVal);
            }
        } # while
        fprintf($this->mFileH, "\n");
        echo "\nProcessed: $tCount \n";
        fclose($this->mFileH);

        echo "\nSorting \n";
        $tTmpFile = $this->mDirTmp . '/t.tmp';
        shell_exec("/bin/bash -c \"$cgBin/sort-para.sh <$this->mFileOut >$tTmpFile\"");
        rename($tTmpFile, $this->mFileOut);
    } # fExportTable

} # ExportLo2Txt

?>
