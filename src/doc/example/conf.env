# Config file for libre-bib. In some places the definition order
# matters.  This file contains bash variables that will be sourced.
# DO NOT put code in this file!

# Manual: /opt/libre-bib/doc/manual/libre-bib.* See: Annotated conf.env
# App defaults: /opt/libre-bib/etc/conf.env
# User template: /opt/libre-bib/doc/example/conf.env

    #cgDebug=false
    #cgNoExec=false
    #cgVerbose=true

    #cgDirBackup="backup"
    #cgDirEtc="etc"
    #cgDirStatus="status"
    #cgDirTmp="tmp"
    #cgDirCache="bib-cache"

# libreoffice
##export cgDirLibreofficeConf="$HOME/.config/libreoffice/4/user/database/biblio"

# libreoffice-flatpak
    #cgDirLibreofficeConf="$HOME/.var/app/org.libreoffice.LibreOffice/config/libreoffice/4/user/database/biblio"

    #cgBackupNum=2

    #cgDbHost="localhost"
    #cgDbName="biblio_example"
    #cgDbPassCache="$cgDirCache/.pass.tmp"
    #cgDbPassHint="b4n"
    #cgDbPortLocal="3306"
    #cgDbTblBib="bib"
    #cgDbTblLo="lo"
    #cgDbUser="$USER"

    #cgLoFile="biblio.txt"
    #cgDocFile="example.odt"
    #cgBackupFile="$cgDirBackup/backup-lo.csv"
